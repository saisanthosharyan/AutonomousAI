# ==========================
# Application
# ==========================
PROJECT_NAME=AutoDev AI
PROJECT_VERSION=0.1.0
DEBUG=False

HOST=0.0.0.0
PORT=8000

# Replace with a strong random secret in production
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRATION_HOURS=24

# ==========================
# LLM Configuration
# ==========================

# Providers are tried from left to right.
LLM_PRIORITY=gemini,openai,openrouter,ollama

# ---------- Gemini ----------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# ---------- OpenAI ----------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ==========================
# Database
# ==========================
DATABASE_URL=sqlite:///../autodev.db

# ==========================
# Vector Database
# ==========================
CHROMA_DB_PATH=./chroma_db

# ==========================
# Retry / Self-Healing
# ==========================
MAX_RETRIES=3
RETRY_DELAY=2

# ==========================
# Run Concurrency
# ==========================
MAX_CONCURRENT_RUNS=2

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO
